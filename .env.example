# Configurazione opzionale Firebase (Spark Plan gratuito)
# Se lasciati vuoti, l'app attiva automaticamente la sincronizzazione locale in tempo reale
# tramite localStorage + BroadcastChannel tra schede dello stesso browser.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
